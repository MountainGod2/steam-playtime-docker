{
  "extends": [
    "config:best-practices"
  ],
  "platformAutomerge": true,
  "internalChecksFilter": "strict",
  "dependencyDashboard": true,
  "packageRules": [
    {
      "description": "Automerge minor and patch updates, minimum release age 8 days",
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "minimumReleaseAge": "8 days"
    },
    {
      "description": "Automerge digest updates, minimum release age 1 day",
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash",
      "minimumReleaseAge": "1 day"
    },
    {
      "description": "Automerge devDependencies minor and patch, minimum release age 3 days",
      "matchDepTypes": [
        "devDependencies"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "3 days"
    },
    {
      "description": "Require dashboard approval for major updates, assign for review",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "assignees": [
        "MountainGod2"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "pre-commit": {
    "enabled": true
  }
}
